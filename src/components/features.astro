---
import { Icon } from "astro-icon/components";
import ContentSection from "~/components/content-section.astro";
import type { FeatureItem } from "~/types";

const features: Array<FeatureItem> = [
  {
    title: "Quick Capture",
    description:
      "Select any text on a webpage and instantly save it to your notepad. No copying, no pasting - just one click.",
    icon: "mdi:cursor-default-click",
  },
  {
    title: "Customizable Keyboard Shortcuts",
    description:
      "Every operation can be customized with keyboard shortcuts - maximize your efficiency and workflow speed.",
    icon: "mdi:keyboard",
  },
  {
    title: "Side Panel View",
    description:
      "Beautiful side panel interface that doesn't interrupt your browsing. View and edit your notes alongside any webpage.",
    icon: "mdi:dock-right",
  },
  {
    title: "Customizable Line Breaks",
    description:
      "Customize line breaks between newly added content. Perfect for pasting into different text editors with proper formatting.",
    icon: "mdi:format-line-spacing",
  },
  {
    title: "Multiple Notebooks",
    description:
      "Organize content across 3 separate note tabs. Perfect for categorizing research, work tasks, and personal notes.",
    icon: "mdi:book-multiple",
  },
  {
    title: "Export & Backup",
    description:
      "Export your notes to text files for safekeeping. Your data stays local and secure - complete privacy guaranteed.",
    icon: "mdi:download",
  },
];
---

<ContentSection title="Features" id="features">
  <Fragment slot="lead">
    Immersive Notepad comes <span class="text-primary">fully featured</span> out of the box.
    Everything you need for <span class="text-primary">efficient</span> web content
    collection with a <span class="text-primary">delightful</span> user experience.
  </Fragment>
  <ul class="grid max-w-6xl grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
    {
      features.map(({ title, description, icon }) => (
        <li class="flex flex-col items-center gap-4 border border-default bg-offset p-6">
          <div class="size-16 rounded-full border-2 border-current p-3">
            <Icon name={icon} class="size-full" />
          </div>
          <p class="text-center font-extrabold text-xl">{title}</p>
          <p class="text-center text-offset text-sm">{description}</p>
        </li>
      ))
    }
  </ul>
</ContentSection>
