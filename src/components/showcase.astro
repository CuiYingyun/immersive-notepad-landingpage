---
import { Icon } from "astro-icon/components";
import ContentSection from "~/components/content-section.astro";

const useCases = [
  {
    title: "Craft Complex Prompts",
    description: "Write prompts in an immersive, distraction-free environment, then paste directly into ChatGPT or any LLM tool. No more struggling with small input boxes.",
    icon: "mdi:brain",
  },
  {
    title: "Three-Notepad Organization",
    description: "Three notepads - not too many, not too few. Organize your prompts perfectly. For more complex needs, use professional note-taking tools instead.",
    icon: "mdi:book-multiple",
  },
  {
    title: "Collect Content from Multiple LLMs",
    description: "Easily capture interesting text from ChatGPT, Claude, or any LLM tool with right-click or keyboard shortcuts.",
    icon: "mdi:content-copy",
  },
  {
    title: "Keyboard-Driven Workflow",
    description: "Switch between notepads, copy, paste, and add web content - all with customizable keyboard shortcuts for maximum efficiency.",
    icon: "mdi:keyboard",
  },
  {
    title: "Less is More Philosophy",
    description: "Designed with minimalism in mind. Three notepads provide just enough space for organizing prompts without overwhelming complexity.",
    icon: "mdi:yin-yang",
  },
  {
    title: "Seamless LLM Integration",
    description: "The perfect companion for your daily LLM workflows. Quickly transfer content between your notepads and any AI chat interface.",
    icon: "mdi:robot",
  },
];
---

<ContentSection title="Why Choose Immersive Notepad?" id="showcase">
  <Fragment slot="lead">
    Built specifically for the <span class="text-primary">LLM workflow</span>.
    Your perfect companion for <span class="text-primary">ChatGPT</span>,
    <span class="text-primary">Gemini</span>, and all AI tools.
  </Fragment>
  <div class="max-w-6xl">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {useCases.map(({ title, description, icon }) => (
        <div class="flex flex-col gap-4 border border-default bg-offset p-6 rounded-lg hover:border-primary transition-colors">
          <div class="flex items-center gap-3">
            <div class="size-12 rounded-full border-2 border-current p-2 text-primary">
              <Icon name={icon} class="size-full" />
            </div>
            <h3 class="font-bold text-xl">{title}</h3>
          </div>
          <p class="text-offset">{description}</p>
        </div>
      ))}
    </div>
  </div>
</ContentSection>
