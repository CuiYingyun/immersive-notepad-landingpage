---
import { Icon } from "astro-icon/components";
import ContentSection from "~/components/content-section.astro";

const useCases = [
  {
    title: "Craft Complex Prompts",
    description: "Write highly complex prompts in a distraction-free environment, then copy and paste them to multiple LLM tools like ChatGPT, Claude, or Gemini for comparison.",
    icon: "mdi:brain",
  },
  {
    title: "Combine Multiple Texts",
    description: "Quickly gather and combine multiple pieces of text into a single notepad, creating comprehensive prompt materials perfect for research tasks.",
    icon: "mdi:content-copy",
  },
  {
    title: "Capture Ideas Instantly",
    description: "Quickly capture thoughts and ideas without switching applications. Everything happens within your browser for a seamless workflow.",
    icon: "mdi:lightbulb-on",
  },
];
---

<ContentSection title="Use Cases" id="showcase">
  <Fragment slot="lead">
    Built specifically for the <span class="text-primary">LLM workflow</span>.
    Your perfect companion for <span class="text-primary">ChatGPT</span>,
    <span class="text-primary">Gemini</span>, and all AI tools.
  </Fragment>
  <div class="max-w-6xl">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {useCases.map(({ title, description, icon }) => (
        <div class="flex flex-col gap-4 border border-default bg-offset p-6 rounded-lg hover:border-primary transition-colors">
          <div class="flex items-center gap-3">
            <div class="size-12 rounded-full border-2 border-current p-2 text-primary">
              <Icon name={icon} class="size-full" />
            </div>
            <h3 class="font-bold text-xl">{title}</h3>
          </div>
          <p class="text-offset">{description}</p>
        </div>
      ))}
    </div>
  </div>
</ContentSection>
