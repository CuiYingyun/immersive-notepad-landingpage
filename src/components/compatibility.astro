---
import CompatibilityList from "~/components/compatibility-list.astro";
import ContentSection from "~/components/content-section.astro";
import type { CompatibilityItem } from "~/types";

const browsers: Array<CompatibilityItem> = [
  {
    title: "Chrome",
    icon: "mdi:google-chrome",
    url: "https://www.google.com/chrome/",
  },
  {
    title: "Edge",
    icon: "mdi:microsoft-edge",
    url: "https://www.microsoft.com/edge",
  },
];

const features: Array<CompatibilityItem> = [
  {
    title: "Dark Mode",
    icon: "mdi:theme-light-dark",
    url: "#",
  },
  {
    title: "Local Storage",
    icon: "mdi:database",
    url: "#",
  },
  {
    title: "Privacy First",
    icon: "mdi:shield-lock",
    url: "#",
  },
  {
    title: "Keyboard Shortcuts",
    icon: "mdi:keyboard",
    url: "#",
  },
  {
    title: "Word Count",
    icon: "mdi:counter",
    url: "#",
  },
  {
    title: "Auto Save",
    icon: "mdi:content-save-check",
    url: "#",
  },
];
---

<ContentSection title="Browser Support" id="compatibility">
  <Fragment slot="lead">
    Currently supports <span class="text-primary">Chrome</span> and
    <span class="text-primary">Edge</span> browsers.
    Built with <span class="text-primary">privacy</span> and
    <span class="text-primary">performance</span> in mind.
  </Fragment>
  <CompatibilityList
    items={browsers}
    title="Supported Browsers"
    url="#"
  />
  <CompatibilityList
    items={features}
    title="Key Features"
    url="#features"
  />
</ContentSection>
