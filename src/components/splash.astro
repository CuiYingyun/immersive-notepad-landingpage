---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import chatgptCompanionImage from "~/assets/chatgpt-companion.png";
import HeroImage from "~/components/hero-image.astro";
import Starfield from "~/components/starfield.astro";

const widths = [450, 800];
const sizes = "(min-width: 640px) 42vw, 67vw";
---

<section class="relative h-full bg-black">
  <Starfield />
  <div id="splash-bg-fallback" class="absolute inset-0 hidden opacity-40">
    <HeroImage />
  </div>
  <div class="relative flex h-full flex-col items-center justify-center gap-8 px-8 py-16">
    <div
      id="companion-image"
      class="w-full max-w-6xl"
    >
      <Image
        class="h-auto w-full object-contain rounded-lg shadow-2xl shadow-purple-500/30 border border-purple-500/20"
        src={chatgptCompanionImage}
        widths={[800, 1200, 1800]}
        sizes="(min-width: 1280px) 85vw, 95vw"
        loading="eager"
        alt="Immersive Notepad ChatGPT Companion Interface"
      />
    </div>
    <h2
      class="flex flex-col items-center"
    >
      <div
        class="gradient-text text-center font-extrabold tracking-tighter text-5xl md:text-7xl"
      >
        Your Perfect ChatGPT Companion
      </div>
    </h2>
  </div>
</section>

<noscript>
  <style>
    #splash-bg-fallback {
      display: block;
    }
  </style>
</noscript>

<style>
  @keyframes float {
    0% {
      transform: translate3d(0, 0, 0);
    }

    100% {
      transform: translate3d(0, 30px, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #companion-image {
      @apply animate-none;
    }

    :global(#starfield) {
      @apply hidden;
    }

    #splash-bg-fallback {
      @apply block;
    }
  }
</style>
